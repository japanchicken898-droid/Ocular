"""
Compiled FastAPI Wrapper Service
Generated by Ocular Offline Visual Compiler
Workflow: {{ graph.name }}
"""

from __future__ import annotations

import json
from pathlib import Path
import asyncio
import uuid
import time
from typing import Dict, Any, Optional, List
from fastapi import FastAPI, BackgroundTasks, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field

# Import compiled Playwright automation driver
from automation import CompiledWorkflowDriver

app = FastAPI(
    title="Ocular Automation Service - {{ graph.name }}",
    description="Offline compiled automation execution engine with zero runtime vision inference.",
    version="1.0.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# In-memory execution store
RUNS_STORE: Dict[str, Dict[str, Any]] = {}

_GRAPH_FILE = Path(__file__).parent / "state_graph.json"
COMPILED_GRAPH: Dict[str, Any] = (
    json.loads(_GRAPH_FILE.read_text(encoding="utf-8")) if _GRAPH_FILE.exists() else {}
)




class WorkflowRunRequest(BaseModel):
    base_url: str = Field(default="http://localhost:3000", description="Target application root URL")
    headless: bool = Field(default=True, description="Whether to run browser headless")
    slow_mo: int = Field(default=50, description="Milliseconds delay between actions")
    timeout_ms: int = Field(default=10000, description="Default action timeout in milliseconds")
    parameters: Dict[str, Any] = Field(default_factory=dict, description="Custom workflow payload parameters")


class WorkflowRunResponse(BaseModel):
    run_id: str
    status: str
    workflow_name: str
    created_at: float
    result: Optional[Dict[str, Any]] = None


@app.get("/health", tags=["System"])
async def health_check() -> Dict[str, str]:
    """Healthcheck endpoint confirming Ocular compiled service is live."""
    return {
        "status": "healthy",
        "service": "ocular-fastapi-driver",
        "workflow": "{{ graph.name }}",
        "states_count": "{{ graph.nodes | length }}",
        "transitions_count": "{{ graph.edges | length }}",
    }


@app.get("/dag", tags=["Compilation"])
async def get_state_graph() -> Dict[str, Any]:
    """Returns the compiled Muse DAG state machine model."""
    return COMPILED_GRAPH


@app.post("/run", response_model=WorkflowRunResponse, tags=["Execution"])
async def trigger_run(payload: WorkflowRunRequest) -> WorkflowRunResponse:
    """Executes the pre-compiled Playwright automation workflow deterministically."""
    run_id = f"run_{uuid.uuid4().hex[:10]}"
    created_at = time.time()

    driver = CompiledWorkflowDriver(
        base_url=payload.base_url,
        headless=payload.headless,
        slow_mo=payload.slow_mo,
        timeout_ms=payload.timeout_ms,
    )

    RUNS_STORE[run_id] = {
        "run_id": run_id,
        "status": "running",
        "workflow_name": "{{ graph.name }}",
        "created_at": created_at,
        "result": None,
    }

    try:
        result = await driver.execute(params=payload.parameters)
        RUNS_STORE[run_id]["status"] = result.get("status", "completed")
        RUNS_STORE[run_id]["result"] = result
    except Exception as exc:
        RUNS_STORE[run_id]["status"] = "failed"
        RUNS_STORE[run_id]["result"] = {"error": str(exc)}

    return WorkflowRunResponse(
        run_id=run_id,
        status=RUNS_STORE[run_id]["status"],
        workflow_name="{{ graph.name }}",
        created_at=created_at,
        result=RUNS_STORE[run_id]["result"],
    )


@app.get("/runs/{run_id}", response_model=WorkflowRunResponse, tags=["Execution"])
async def get_run_status(run_id: str) -> WorkflowRunResponse:
    """Retrieves status and logs for a specific workflow execution run."""
    run = RUNS_STORE.get(run_id)
    if not run:
        raise HTTPException(status_code=404, detail="Run ID not found")
    return WorkflowRunResponse(**run)


@app.get("/metrics", tags=["Metrics"])
async def get_metrics() -> Dict[str, Any]:
    """Returns execution metrics and compiled performance stats."""
    total_runs = len(RUNS_STORE)
    completed = sum(1 for r in RUNS_STORE.values() if r.get("status") == "completed")
    failed = sum(1 for r in RUNS_STORE.values() if r.get("status") == "failed")

    return {
        "workflow": "{{ graph.name }}",
        "total_runs": total_runs,
        "completed": completed,
        "failed": failed,
        "compiled_states": {{ graph.nodes | length }},
        "compiled_transitions": {{ graph.edges | length }},
        "vision_inference_at_runtime": False,
    }


if __name__ == "__main__":
    import uvicorn
    uvicorn.run("service:app", host="0.0.0.0", port=8000, reload=False)
