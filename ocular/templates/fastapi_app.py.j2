"""Compiled FastAPI Production Service.

Generated by Ocular Offline Visual Compiler.
Workflow: {{ dag.workflow_name }}
Target Compile Hash: {{ compile_hash }}
"""

from __future__ import annotations

import time
import uuid
from typing import Any, Dict, List, Optional
from fastapi import FastAPI, HTTPException, Response, status
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
import sys
from pathlib import Path

_BASE_DIR = Path(__file__).resolve().parent
if str(_BASE_DIR) not in sys.path:
    sys.path.insert(0, str(_BASE_DIR))

from playwright_driver import OcularPlaywrightDriver

COMPILE_HASH = "{{ compile_hash }}"
WORKFLOW_NAME = "{{ dag.workflow_name }}"

app = FastAPI(
    title="Ocular Automation Service - {{ dag.workflow_name }}",
    description="Offline-compiled automation service with zero runtime vision inference.",
    version="1.0.0",
)

# CORS Middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

driver = OcularPlaywrightDriver()


class ExecuteWorkflowRequest(BaseModel):
    workflow_name: Optional[str] = Field(default=WORKFLOW_NAME, description="Target workflow name")
    parameters: Dict[str, Any] = Field(
        default_factory=lambda: {
            {% for inp in input_fields %}
            "{{ inp.key }}": "{{ inp.default_value }}",
            {% endfor %}
        },
        description="Dynamic form parameters: {{ input_keys | join(', ') }}"
    )
    base_url: Optional[str] = Field(default="http://localhost:3000", description="Application root URL")
    viewport_width: Optional[int] = Field(default=1920, description="Viewport width")
    viewport_height: Optional[int] = Field(default=1080, description="Viewport height")
    headless: bool = Field(default=True, description="Headless browser flag")
    timeout_ms: int = Field(default=10000, description="Timeout in milliseconds")


class ExecuteWorkflowResponse(BaseModel):
    success: bool
    execution_id: str
    workflow_name: str
    compile_hash: str
    latency_ms: float
    steps_executed: int
    results: Dict[str, Any]
    errors: Optional[List[str]] = None


class IntervalRequest(BaseModel):
    interval: str = Field(default="15m", description="Target timeframe (e.g., 1m, 5m, 15m, 1h, 1d)")
    viewport_width: Optional[int] = Field(default=1920)
    viewport_height: Optional[int] = Field(default=1080)


@app.get("/health", tags=["System"])
async def health() -> Dict[str, Any]:
    return {
        "status": "ok",
        "compiler": "Ocular",
        "compile_hash": COMPILE_HASH,
        "workflow": WORKFLOW_NAME,
    }


@app.get("/api/v1/schema", tags=["System"])
async def get_parameters_schema() -> Dict[str, Any]:
    """Returns the parameterized dynamic inputs schema and visual anchors registry."""
    return {
        "workflow": WORKFLOW_NAME,
        "compile_hash": COMPILE_HASH,
        "input_parameters": driver.INPUT_FIELDS,
        "anchors_count": len(driver.ANCHORS),
        "zero_runtime_vision": True,
    }


@app.post("/api/v1/execute", response_model=ExecuteWorkflowResponse, tags=["Execution"])
async def execute_workflow(payload: ExecuteWorkflowRequest, response: Response) -> ExecuteWorkflowResponse:
    """Executes the compiled workflow deterministically with Pydantic payload validation."""
    t0 = time.perf_counter()
    execution_id = f"exec_{uuid.uuid4().hex[:12]}"

    if payload.viewport_width and payload.viewport_height:
        driver.viewport_width = payload.viewport_width
        driver.viewport_height = payload.viewport_height
    if payload.base_url:
        driver.base_url = payload.base_url.rstrip("/")
    driver.headless = payload.headless

    try:
        # Pass dynamic parameters to the compiled driver
        result = await driver.execute_workflow(params=payload.parameters)
        latency_ms = round((time.perf_counter() - t0) * 1000.0, 3)

        response.headers["X-Ocular-Compile-Hash"] = COMPILE_HASH
        response.headers["X-Execution-Latency-MS"] = str(latency_ms)

        steps = result.get("steps", [])
        return ExecuteWorkflowResponse(
            success=True,
            execution_id=execution_id,
            workflow_name=WORKFLOW_NAME,
            compile_hash=COMPILE_HASH,
            latency_ms=latency_ms,
            steps_executed=len(steps),
            results=result,
            errors=None,
        )
    except Exception as exc:
        latency_ms = round((time.perf_counter() - t0) * 1000.0, 3)
        response.headers["X-Ocular-Compile-Hash"] = COMPILE_HASH
        response.headers["X-Execution-Latency-MS"] = str(latency_ms)

        return ExecuteWorkflowResponse(
            success=False,
            execution_id=execution_id,
            workflow_name=WORKFLOW_NAME,
            compile_hash=COMPILE_HASH,
            latency_ms=latency_ms,
            steps_executed=0,
            results={},
            errors=[str(exc)],
        )


@app.get("/api/v1/chart/status", tags=["Chart"])
async def chart_status(response: Response) -> Dict[str, Any]:
    """Returns status and visual anchors registered for the chart canvas."""
    t0 = time.perf_counter()
    latency_ms = round((time.perf_counter() - t0) * 1000.0, 3)

    response.headers["X-Ocular-Compile-Hash"] = COMPILE_HASH
    response.headers["X-Execution-Latency-MS"] = str(latency_ms)

    return {
        "status": "ready",
        "workflow": WORKFLOW_NAME,
        "anchors_registered": len(driver.ANCHORS),
        "canvas_present": True,
        "compile_hash": COMPILE_HASH,
    }


@app.post("/api/v1/chart/interval", tags=["Chart"])
async def set_interval_endpoint(payload: IntervalRequest, response: Response) -> Dict[str, Any]:
    """Applies a timeframe interval to the TradingView chart canvas via the compiled driver."""
    t0 = time.perf_counter()

    if payload.viewport_width and payload.viewport_height:
        driver.viewport_width = payload.viewport_width
        driver.viewport_height = payload.viewport_height

    result = await driver.set_interval(interval=payload.interval)
    latency_ms = round((time.perf_counter() - t0) * 1000.0, 3)

    response.headers["X-Ocular-Compile-Hash"] = COMPILE_HASH
    response.headers["X-Execution-Latency-MS"] = str(latency_ms)

    return {
        "success": True,
        "message": f"Successfully applied {payload.interval} interval",
        "data": result,
        "latency_ms": latency_ms,
    }


if __name__ == "__main__":
    import uvicorn
    uvicorn.run("app:app", host="0.0.0.0", port=8000, reload=False)
