@app.post("/api/v1/execute", response_model=ExecuteWorkflowResponse, tags=["Execution"])
async def execute_workflow(
    payload: Union[ExecuteWorkflowRequest, ExecutionPayload],
    response: Response
) -> ExecuteWorkflowResponse:
    """Executes the compiled workflow deterministically with dynamic parameter binding."""
    t0 = time.perf_counter()
    execution_id = f"exec_{uuid.uuid4().hex[:12]}"

    req_base_url = None
    req_width = 1280
    req_height = 720
    req_headless = True
    req_live = False

    if isinstance(payload, ExecuteWorkflowRequest):
        if payload.viewport_width and payload.viewport_height:
            req_width = payload.viewport_width
            req_height = payload.viewport_height
        if payload.base_url:
            req_base_url = await validate_safe_url(payload.base_url)
        req_headless = payload.headless
        req_live = payload.live
        raw_params = payload.parameters if payload.parameters is not None else {}
        try:
            typed_payload = ExecutionPayload(**raw_params)
        except ValidationError as val_exc:
            raise HTTPException(
                status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
                detail=val_exc.errors(),
            )
    elif isinstance(payload, ExecutionPayload):
        typed_payload = payload
        raw_dict = payload.model_dump()
        req_width = raw_dict.get("viewport_width", 1280)
        req_height = raw_dict.get("viewport_height", 720)
        req_headless = raw_dict.get("headless", True)
    else:
        try:
            typed_payload = ExecutionPayload()
        except ValidationError as val_exc:
            raise HTTPException(
                status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
                detail=val_exc.errors(),
            )

    async with _execution_semaphore:
        req_driver = {{ workflow_class_name }}(
            base_url=req_base_url,
            viewport_width=req_width,
            viewport_height=req_height,
            headless=req_headless,
            live=req_live,
        )
        try:
            result = await req_driver.execute_workflow(params=typed_payload.model_dump())
            latency_ms = round((time.perf_counter() - t0) * 1000.0, 3)

            response.headers["X-Ocular-Compile-Hash"] = COMPILE_HASH
            response.headers["X-Execution-Latency-MS"] = str(latency_ms)

            steps = result.get("steps", [])
            success_status = result.get("success", result.get("status") == "success")
            err_msg = [result["error"]] if ("error" in result and not success_status) else None
            return ExecuteWorkflowResponse(
                success=success_status,
                execution_id=execution_id,
                workflow_name=WORKFLOW_NAME,
                compile_hash=COMPILE_HASH,
                latency_ms=latency_ms,
                steps_executed=len(steps),
                results=result,
                errors=err_msg,
            )
        except Exception as exc:
            latency_ms = round((time.perf_counter() - t0) * 1000.0, 3)
            response.headers["X-Ocular-Compile-Hash"] = COMPILE_HASH
            response.headers["X-Execution-Latency-MS"] = str(latency_ms)

            return ExecuteWorkflowResponse(
                success=False,
                execution_id=execution_id,
                workflow_name=WORKFLOW_NAME,
                compile_hash=COMPILE_HASH,
                latency_ms=latency_ms,
                steps_executed=0,
                results={},
                errors=[str(exc)],
            )
        except Exception as exc:
            latency_ms = round((time.perf_counter() - t0) * 1000.0, 3)
            response.headers["X-Ocular-Compile-Hash"] = COMPILE_HASH
            response.headers["X-Execution-Latency-MS"] = str(latency_ms)

            return ExecuteWorkflowResponse(
                success=False,
                execution_id=execution_id,
                workflow_name=WORKFLOW_NAME,
                compile_hash=COMPILE_HASH,
                latency_ms=latency_ms,
                steps_executed=0,
                results={},
                errors=[str(exc)],
            )


