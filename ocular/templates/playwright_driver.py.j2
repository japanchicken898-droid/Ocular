def _is_sensitive_identifier(val: Any) -> bool:
    if not val:
        return False
    text = str(val).lower()
    if 'type="password"' in text or "type='password'" in text:
        return True
    pattern = r"(?:^|[^a-z0-9])(password|passwd|pwd|pass|passcode|passphrase|secret|token|jwt|bearer|session|cookie|otp|2fa|mfa|pin|ssn|cvv|cvc|csc|cardnumber|iban|routing|api[_\s-]?key|private[_\s-]?key|secret[_\s-]?key|access[_\s-]?key|auth[_\s-]?key|one[_\s-]?time(?:[_\s-]?code)?|cc[_\s-]?number|card[_\s-]?number|credit[_\s-]?card)(?:$|[^a-z0-9])"
    return bool(re.search(pattern, text, re.IGNORECASE))


def _redact_workflow_results(res: Dict[str, Any]) -> Dict[str, Any]:
    input_fields = _WORKFLOW_DATA.get("input_fields", {})
    if isinstance(input_fields, list):
        input_fields = {f.get("key", f.get("parameter_ref", "")): f for f in input_fields if isinstance(f, dict)}
    anchors = _WORKFLOW_DATA.get("anchors", {})

    params = res.get("parameters")
    if isinstance(params, dict):
        redacted_params = {}
        for k, v in params.items():
            f_info = input_fields.get(k, {}) if isinstance(input_fields, dict) else {}
            a_info = anchors.get(k, {}) if isinstance(anchors, dict) else {}
            is_sens = (
                _is_sensitive_identifier(k)
                or _is_sensitive_identifier(f_info.get("selector"))
                or _is_sensitive_identifier(f_info.get("label"))
                or _is_sensitive_identifier(a_info.get("suggested_selector"))
                or _is_sensitive_identifier(a_info.get("label"))
            )
            if is_sens:
                redacted_params[k] = "[REDACTED]"
            else:
                redacted_params[k] = v
        res["parameters"] = redacted_params

    steps = res.get("steps")
    if isinstance(steps, list):
        for s in steps:
            if isinstance(s, dict):
                anchor = s.get("anchor") or ""
                param_ref = s.get("parameter_ref") or ""
                selector = s.get("selector") or ""
                f_info = input_fields.get(param_ref, {}) if isinstance(input_fields, dict) else {}
                a_info = anchors.get(anchor, {}) if isinstance(anchors, dict) else {}
                is_sens = (
                    _is_sensitive_identifier(anchor)
                    or _is_sensitive_identifier(param_ref)
                    or _is_sensitive_identifier(selector)
                    or _is_sensitive_identifier(f_info.get("selector"))
                    or _is_sensitive_identifier(f_info.get("label"))
                    or _is_sensitive_identifier(a_info.get("suggested_selector"))
                    or _is_sensitive_identifier(a_info.get("label"))
                )
                if is_sens:
                    if "value" in s and s["value"] is not None:
                        s["value"] = "[REDACTED]"
    return res


