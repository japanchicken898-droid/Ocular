        .menu-item { height: 4.5vh; min-height: 32px; display: flex; align-items: center; padding: 0 16px; font-size: 14px; font-weight: 500; color: #d1d4dc; cursor: pointer; border-bottom: 1px solid #2a2e39; transition: background 0.15s; }
