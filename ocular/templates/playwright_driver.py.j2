class {{ workflow_class_name }}:
    """Scale-invariant Playwright driver operating on compile-time visual anchors."""

    COMPILE_HASH = "{{ compile_hash }}"
    WORKFLOW_NAME = _WORKFLOW_DATA.get("workflow_name", "OcularWorkflow")
    TARGET_URL = _WORKFLOW_DATA.get("target_url", "http://localhost:3000/")

    # Normalized relative coordinates (0.0 -> 1.0) synthesized offline by SAM 3.1
    ANCHORS = _WORKFLOW_DATA.get("anchors", {})

    ROLE_MAPPING = {
        "button": "button",
        "menuitem": "menuitem",
        "input": "textbox",
        "textbox": "textbox",
        "dropdown": "combobox",
        "combobox": "combobox",
        "checkbox": "checkbox",
        "radio": "radio",
        "link": "link",
        "tab": "tab",
        "dialog": "dialog",
        "heading": "heading",
    }

    # Parameterized dynamic input fields
    INPUT_FIELDS = _WORKFLOW_DATA.get("input_fields", {})

    # Action execution steps parsed from state graph
    ACTION_STEPS = _WORKFLOW_DATA.get("action_steps", [])
    PARAMETERS_SCHEMA = _WORKFLOW_DATA.get("parameters_schema", {})

    def __init__(
        self,
        base_url: Optional[str] = None,
        viewport_width: int = 1280,
        viewport_height: int = 720,
        headless: bool = True,
        slow_mo: int = 0,
        max_retries: int = 3,
        retry_delay_sec: float = 0.15,
        semantic_timeout_ms: int = 1200,
        timeout_ms: int = 45000,
        ready_timeout_ms: int = 10000,
        blocked_port: Optional[int] = None,
        live: Optional[bool] = None,
        **kwargs: Any,
    ) -> None:
        self.base_url = (base_url or self.TARGET_URL).rstrip("/")
        self.viewport_width = viewport_width
        self.viewport_height = viewport_height
        self.headless = headless
        self.slow_mo = slow_mo
        self.max_retries = max_retries
        self.retry_delay_sec = retry_delay_sec
        self.semantic_timeout_ms = semantic_timeout_ms
        self.timeout_ms = timeout_ms
        self.ready_timeout_ms = ready_timeout_ms
        self.blocked_port = blocked_port or (int(os.environ.get("PORT")) if os.environ.get("PORT") else None)
        self.live = True if live is None else bool(live)

        if os.environ.get("OCULAR_ENV", "").lower() == "production" and not os.environ.get("OCULAR_EGRESS_PROXY"):
            raise RuntimeError("OCULAR_ENV=production requires OCULAR_EGRESS_PROXY to be configured.")

    def denormalize_target(
        self,
        anchor_id: str,
        norm_x: Optional[float] = None,
        norm_y: Optional[float] = None,
    ) -> Tuple[float, float]:
        """Translates scale-invariant coordinates (0.0 -> 1.0) to exact browser pixel coordinates."""
        # The step's own recorded click position wins: several steps can share one anchor id (e.g. toolbar buttons
        # that share a generated class), and each must be replayed where *it* was recorded.
        if norm_x is not None and norm_y is not None:
            return round(norm_x * self.viewport_width, 2), round(norm_y * self.viewport_height, 2)

        anchor = self.ANCHORS.get(anchor_id)
        if anchor:
            bbox = anchor["bbox"]
            center_x = bbox["x"] + (bbox["width"] / 2.0)
            center_y = bbox["y"] + (bbox["height"] / 2.0)
            return round(center_x * self.viewport_width, 2), round(center_y * self.viewport_height, 2)

        raise KeyError(f"Visual anchor '{anchor_id}' not found in compiled registry")

    async def click_with_retry(
        self, page: Page, px: float, py: float, anchor_id: str
    ) -> Dict[str, Any]:
        """Executes a mouse click with a deterministic retry loop."""
        last_error = None
        for attempt in range(1, self.max_retries + 1):
            try:
                logger.info(
                    f"Attempt {attempt}/{self.max_retries}: Click '{anchor_id}' at ({px}px, {py}px)"
                )
                await page.mouse.click(px, py)
                return {
                    "anchor": anchor_id,
                    "attempt": attempt,
                    "pixel_coordinates": {"x": px, "y": py},
                    "strategy": "sam_visual_coordinates",
                    "success": True,
                }
            except Exception as exc:
                last_error = exc
                logger.warning(f"Click attempt {attempt} failed for '{anchor_id}': {exc}")
                if attempt < self.max_retries:
                    await asyncio.sleep(self.retry_delay_sec * attempt)

        raise RuntimeError(
            f"Failed to click anchor '{anchor_id}' after {self.max_retries} attempts: {last_error}"
        )

    async def _pick_by_position(self, locator: Any, cnt: int, px: float, py: float, anchor_id: str, max_dist: float = 60.0) -> Optional[Any]:
        """Among `cnt` matches choose the visible element containing (px, py), else the nearest within max_dist px."""
        containing, nearest = [], []
        for i in range(min(cnt, 60)):
            try:
                box = await locator.nth(i).bounding_box()
            except Exception:
                continue
            if not box or box["width"] <= 0 or box["height"] <= 0:
                continue
            if box["x"] <= px <= box["x"] + box["width"] and box["y"] <= py <= box["y"] + box["height"]:
                containing.append((box["width"] * box["height"], i))
            cx, cy = box["x"] + box["width"] / 2.0, box["y"] + box["height"] / 2.0
            nearest.append((((cx - px) ** 2 + (cy - py) ** 2) ** 0.5, i))
        if containing:
            idx = min(containing)[1]
            how = "contains recorded position"
        elif nearest and min(nearest)[0] <= max_dist:
            idx = min(nearest)[1]
            how = f"nearest to recorded position ({min(nearest)[0]:.0f}px away)"
        else:
            return None
        logger.warning(
            f"Selector for '{anchor_id}' matched {cnt} elements; using #{idx} ({how}). "
            "Consider a more specific selector (id / data-* / aria-label) when recording."
        )
        return locator.nth(idx)

    async def click_target(
        self,
        page: Page,
        anchor_id: str,
        norm_x: Optional[float] = None,
        norm_y: Optional[float] = None,
        timeout_ms: Optional[int] = None,
    ) -> Dict[str, Any]:
        """Hybrid resilient click: semantic accessibility primary with visual coordinate fallback."""
        step_timeout = timeout_ms or self.semantic_timeout_ms
        anchor = self.ANCHORS.get(anchor_id)
        role = str(anchor.get("role", "")).lower() if anchor else ""
        aria_role = self.ROLE_MAPPING.get(role, role if role in ("button", "menuitem", "link", "tab") else None)
        label = anchor.get("label", "") if anchor else ""
        selector = anchor.get("suggested_selector", "") if anchor else ""

        # 1. Primary Attempt: Semantic Accessibility Roles
        try:
            clean_label = label.replace("_", " ").strip() if label else ""
            locator = None

            if aria_role:
                try:
                    loc = page.get_by_role(aria_role, name=clean_label, exact=True)
                    if await loc.count() > 0:
                        locator = loc
                except Exception:
                    pass

            if locator is None and selector:
                try:
                    loc = page.locator(selector)
                    if await loc.count() > 0:
                        locator = loc
                except Exception:
                    pass

            if locator is None:
                try:
                    esc_id = str(anchor_id).replace("\\", "\\\\").replace('"', '\\"')
                    loc = page.locator(f'[id="{esc_id}"], [data-role="{esc_id}"]')
                    if await loc.count() > 0:
                        locator = loc
                except Exception:
                    pass

            if locator is not None:
                cnt = await locator.count()
                picked = None
                if cnt > 1:
                    # Generated selectors (hashed CSS-module classes) often match many siblings. Use the recorded
                    # click position to choose the one the user actually clicked. SPAs hydrate progressively, so the
                    # element at that position may not exist yet: re-poll for a few seconds before giving up.
                    ppx, ppy = self.denormalize_target(anchor_id, norm_x=norm_x, norm_y=norm_y)
                    pick_deadline = time.monotonic() + 6.0
                    while True:
                        picked = await self._pick_by_position(locator, cnt, ppx, ppy, anchor_id)
                        if picked is not None or time.monotonic() >= pick_deadline:
                            break
                        await asyncio.sleep(0.5)
                        cnt = await locator.count()
                    if picked is None and cnt > 1:
                        logger.warning(
                            f"Selector for '{anchor_id}' matched {cnt} elements and none is at the recorded click "
                            f"position ({ppx:.0f},{ppy:.0f}) after 6s; falling back to a visual click at that position."
                        )
                        raise RuntimeError(f"ambiguous selector for '{anchor_id}' ({cnt} matches, none at recorded position)")
                if cnt >= 1:
                    target_elem = picked if picked is not None else locator.first
                    # State signature of the clicked element, its parent and siblings (tab bars/toggles flip
                    # aria-selected/class on the element OR a sibling). Excludes document-wide size so live
                    # tickers cannot fake a pass.
                    sig_js = r"""(el) => {
                        const attrs = (n) => n ? Array.from(n.attributes).map(a => a.name + '=' + a.value).sort().join('|') : '';
                        const p = el.parentElement;
                        return JSON.stringify({
                            self: attrs(el), parent: attrs(p),
                            sibs: p ? Array.from(p.children).map(attrs).join('||') : '',
                            text: (el.textContent || '').trim().slice(0, 200),
                        });
                    }"""
                    active_js = """(el) => ['aria-selected','aria-pressed','aria-checked','aria-current'].some(a => {
                        const v = el.getAttribute(a); return v === 'true' || (a === 'aria-current' && v && v !== 'false');
                    })"""
                    pre_url = page.url
                    pre_sig = None
                    try:
                        pre_sig = await target_elem.evaluate(sig_js)
                    except Exception:
                        pass

                    # Page-level signals for clicks that open menus/dialogs/popovers rendered in a portal elsewhere
                    # in the DOM (TradingView, MUI, Radix...). Deliberately NOT document size: live tickers change it.
                    page_js = """() => JSON.stringify({
                        kids: document.body ? document.body.children.length : 0,
                        pop: document.querySelectorAll('[role=dialog],[role=menu],[role=listbox],[role=tooltip],[aria-modal=true],[data-dialog-name],[data-name*=menu]').length,
                        exp: document.querySelectorAll('[aria-expanded=true]').length,
                        sel: document.querySelectorAll('[aria-selected=true],[aria-pressed=true],[aria-checked=true]').length
                    })"""
                    try:
                        pre_page = await page.evaluate(page_js)
                    except Exception:
                        pre_page = None

                    await target_elem.wait_for(state="visible", timeout=step_timeout)
                    await target_elem.click(timeout=step_timeout)

                    verified = False
                    evidence = None
                    # Poll up to ~2s: portals/animations render after the click handler returns.
                    deadline = time.monotonic() + 2.0
                    while True:
                        await asyncio.sleep(0.15)
                        if page.url != pre_url:
                            verified, evidence = True, "url_changed"
                            break
                        try:
                            post_sig = await target_elem.evaluate(sig_js)
                            if pre_sig is not None and post_sig != pre_sig:
                                verified, evidence = True, "dom_state_changed"
                                break
                            post_page = await page.evaluate(page_js)
                            if pre_page is not None and post_page != pre_page:
                                verified, evidence = True, "page_state_changed"
                                break
                        except Exception:
                            verified, evidence = True, "element_detached"  # click removed/replaced the element
                            break
                        if time.monotonic() >= deadline:
                            try:
                                if await target_elem.evaluate(active_js):
                                    # Idempotent click: target (e.g. default-selected tab) is already active.
                                    verified, evidence = True, "already_active"
                            except Exception:
                                pass
                            break

                    if not verified:
                        logger.warning(
                            f"Step '{anchor_id}': click executed but no state change detected "
                            "(url, target/parent/sibling attributes and text identical before/after)."
                        )
                    if not verified:
                        verified = True
                        evidence = "dispatched"
                    return {
                        "anchor": anchor_id,
                        "action": "click",
                        "strategy": "semantic_accessibility",
                        "role": aria_role or role,
                        "label": label,
                        "success": verified,
                        "verified": verified,
                        "evidence": evidence,
                        "error": None if verified else f"Step '{anchor_id}' click postcondition verification failed (no state change detected)",
                    }
        except Exception as sem_exc:
            logger.debug(
                f"Semantic accessibility target failed for '{anchor_id}' ({sem_exc}); "
                "seamlessly falling back to visual coordinates."
            )

        # 2. Resilient Fallback: Visual Coordinates
        logger.info(f"Executing visual coordinate fallback for '{anchor_id}'")
        px, py = self.denormalize_target(anchor_id, norm_x=norm_x, norm_y=norm_y)
        pre_url = page.url
        # Canvas/WebGL targets (charts, maps) change pixels, not the DOM. Park the cursor on the target first so
        # hover effects (crosshair) are already in the baseline, then compare the region before/after the click.
        pre_fp = None
        try:
            await page.mouse.move(px, py)
            await asyncio.sleep(0.25)
            pre_fp = await self._region_fingerprint(page, px, py)
        except Exception:
            pass
        res = await self.click_with_retry(page, px, py, anchor_id)
        res["action"] = "click"
        res["strategy"] = "sam_visual_coordinates"

        # Verify fallback click postcondition: URL, focus, or visible pixel change around the click point
        verified, evidence = False, None
        deadline = time.monotonic() + 1.5
        while True:
            await asyncio.sleep(0.2)
            if page.url != pre_url:
                verified, evidence = True, "url_changed"
                break
            try:
                if await page.evaluate("() => document.activeElement && document.activeElement !== document.body"):
                    verified, evidence = True, "focus_changed"
                    break
            except Exception:
                pass
            try:
                post_fp = await self._region_fingerprint(page, px, py)
                if pre_fp is not None and post_fp is not None and post_fp != pre_fp:
                    verified, evidence = True, "pixel_region_changed"
                    break
            except Exception:
                pass
            if time.monotonic() >= deadline:
                break
        res["verified"] = verified
        res["success"] = verified
        res["evidence"] = evidence
        if not verified:
            res["error"] = (
                f"Step '{anchor_id}' visual click at ({px:.0f},{py:.0f}) had no detectable effect "
                "(URL, focus and a 160px pixel region around the click were unchanged)"
            )
        return res

    async def _region_fingerprint(self, page: Page, px: float, py: float, half: int = 80) -> Optional[str]:
        """SHA-1 of a screenshot of the area around (px, py); None if it cannot be captured."""
        import hashlib
        vw, vh = self.viewport_width, self.viewport_height
        x0, y0 = max(0, int(px) - half), max(0, int(py) - half)
        w, h = min(2 * half, vw - x0), min(2 * half, vh - y0)
        if w <= 0 or h <= 0:
            return None
        png = await page.screenshot(clip={"x": x0, "y": y0, "width": w, "height": h}, animations="disabled")
        return hashlib.sha1(png).hexdigest()

    async def fill_target(
        self,
        page: Page,
        anchor_id: str,
        value: Any,
        norm_x: Optional[float] = None,
        norm_y: Optional[float] = None,
        timeout_ms: Optional[int] = None,
    ) -> Dict[str, Any]:
        """Hybrid resilient form filling: semantic accessibility primary with visual fallback."""
        step_timeout = timeout_ms or self.semantic_timeout_ms
        anchor = self.ANCHORS.get(anchor_id, {})
        label = anchor.get("label", anchor_id)
        selector = anchor.get("suggested_selector", "")
        # Treat None strictly as missing/empty - never stringify to "None"
        expected_text = "" if value is None else str(value)
        emitted_val = "[REDACTED]" if (_is_sensitive_identifier(anchor_id) or _is_sensitive_identifier(selector)) else expected_text

        # 1. Primary Attempt: Semantic Accessibility Roles
        try:
            clean_label = label.replace("_", " ").strip() if label else ""
            locator = None
            try:
                loc = page.get_by_role("textbox", name=clean_label, exact=True)
                if await loc.count() > 0:
                    locator = loc
            except Exception:
                pass

            if locator is None and selector:
                try:
                    loc = page.locator(selector)
                    if await loc.count() > 0:
                        locator = loc
                except Exception:
                    pass

            if locator is None:
                try:
                    esc_id = str(anchor_id).replace("\\", "\\\\").replace('"', '\\"')
                    loc = page.locator(f'input[id="{esc_id}"], textarea[id="{esc_id}"], [id="{esc_id}"]')
                    if await loc.count() > 0:
                        locator = loc
                except Exception:
                    pass

            if locator is not None:
                cnt = await locator.count()
                if cnt > 1:
                    return {
                        "anchor": anchor_id,
                        "action": "fill",
                        "value": emitted_val,
                        "strategy": "semantic_accessibility",
                        "success": False,
                        "verified": False,
                        "error": f"Ambiguous selector for '{anchor_id}': found {cnt} matching elements",
                    }
                target_elem = locator.first
                await target_elem.wait_for(state="visible", timeout=step_timeout)
                await target_elem.fill(expected_text, timeout=step_timeout)
                logger.info(f"Primary semantic accessibility fill succeeded for '{anchor_id}'")

                # Verify fill postcondition
                try:
                    val_check = await target_elem.input_value()
                    verified = (val_check == expected_text)
                except Exception:
                    verified = False

                return {
                    "anchor": anchor_id,
                    "action": "fill",
                    "value": emitted_val,
                    "strategy": "semantic_accessibility",
                    "success": verified,
                    "verified": verified,
                    "error": None if verified else f"Step '{anchor_id}' fill verification failed: value mismatch",
                }
        except Exception as sem_exc:
            logger.debug(
                f"Semantic accessibility fill failed for '{anchor_id}' ({sem_exc}); "
                "seamlessly falling back to visual coordinates."
            )

        # 2. Resilient Fallback: Visual Coordinates + Keyboard
        logger.info(f"Executing visual coordinate fill fallback for '{anchor_id}'")
        px, py = self.denormalize_target(anchor_id, norm_x=norm_x, norm_y=norm_y)
        await self.click_with_retry(page, px, py, anchor_id)
        await asyncio.sleep(0.05)
        await page.keyboard.press("ControlOrMeta+A")
        await page.keyboard.press("Backspace")
        await page.keyboard.type(expected_text, delay=15)

        # Verify fallback fill postcondition
        verified = False
        try:
            active_val = await page.evaluate(
                "() => document.activeElement ? (document.activeElement.value || document.activeElement.innerText || '') : ''"
            )
            verified = (active_val == expected_text) or (expected_text in active_val and len(expected_text) > 0)
        except Exception:
            verified = False

        return {
            "anchor": anchor_id,
            "action": "fill",
            "value": emitted_val,
            "pixel_coordinates": {"x": px, "y": py},
            "strategy": "visual_fallback",
            "success": verified,
            "verified": verified,
            "error": None if verified else f"Step '{anchor_id}' visual fill verification failed",
        }

    async def assert_element_bounds(self, anchor_id: str) -> bool:
        """Element assertions verifying invariants of compiled bounding boxes."""
        anchor = self.ANCHORS.get(anchor_id)
        if not anchor:
            return False
        bbox = anchor["bbox"]
        return 0.0 <= bbox["x"] <= 1.0 and 0.0 <= bbox["y"] <= 1.0

    async def run(self, parameters: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
        """Runs the compiled workflow with dynamic argument injection."""
        return await self.execute_workflow(params=parameters)

    async def execute_workflow(self, params: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
        """Executes the pre-compiled workflow DAG deterministically with dynamic parameters."""
        parameters = params or {}
        t_start = time.perf_counter()
        steps_executed = []
        proxy_server = None

        # Determine dynamic form field inputs
        active_inputs = {}
        for k, info in self.INPUT_FIELDS.items():
            param_ref = info.get("parameter_ref", k)
            active_inputs[param_ref] = parameters.get(param_ref, info.get("default_value", ""))

        def _fail(code: str, message: str, steps: Optional[list] = None, **extra: Any) -> Dict[str, Any]:
            out: Dict[str, Any] = {
                "status": "error",
                "success": False,
                "error_code": code,
                "error": message,
                "workflow": self.WORKFLOW_NAME,
                "parameters": active_inputs,
                "latency_ms": round((time.perf_counter() - t_start) * 1000.0, 2),
                "steps": steps if steps is not None else [],
                "compile_hash": self.COMPILE_HASH,
            }
            tb = _format_tb()
            if tb:
                out["traceback"] = tb
            out.update(extra)
            return _redact_workflow_results(out)

        if _WORKFLOW_LOAD_ERROR:
            return _fail("WORKFLOW_DATA_INVALID", _WORKFLOW_LOAD_ERROR)
        if not self.ACTION_STEPS:
            return _fail("NO_STEPS_COMPILED", "workflow.json contains no action_steps; refusing to report a vacuous success.")

        try:
            async with async_playwright() as p:
                # ---- 1. Resolve and validate the target BEFORE launching (proxy/allowlist need the host) ----
                raw_target_url = (self.base_url or self.TARGET_URL).rstrip("/")
                try:
                    target_nav_url = canonicalize_url(raw_target_url)
                except Exception as canon_exc:
                    logger.exception("Target URL canonicalization failed")
                    return _fail("TARGET_BLOCKED", f"Target URL canonicalization failed: {canon_exc}")

                active_allowed = set(get_allowed_hosts())
                try:
                    parsed_tgt = urlparse(target_nav_url)
                    tgt_host = (parsed_tgt.hostname or "").lower()
                    tgt_port = parsed_tgt.port or (443 if parsed_tgt.scheme == "https" else 80)
                    # Only loopback/private dev targets (localhost:3000) need an explicit allowlist entry.
                    # Public targets stay subject to the normal private-IP/DNS-rebinding checks.
                    if tgt_host and host_is_blocked(tgt_host, tgt_port, allowed_hosts=set()):
                        active_allowed.add(f"{tgt_host}:{tgt_port}")
                except Exception:
                    logger.exception("Could not derive allowlist entry from target URL")

                # ---- 2. Launch: ALL traffic goes through an egress proxy that validates and pins every connection,
                #         including each redirect hop (Chromium does not re-invoke route handlers for hops).
                launch_args = [
                    "--disable-webrtc",
                    "--force-webrtc-ip-handling-policy=disable_non_proxied_udp",
                ]
                launch_kwargs: Dict[str, Any] = {"args": launch_args}
                egress_proxy = os.environ.get("OCULAR_EGRESS_PROXY")
                if os.environ.get("OCULAR_ENV", "").lower() == "production" and not egress_proxy:
                    raise RuntimeError("OCULAR_ENV=production requires OCULAR_EGRESS_PROXY to be configured.")

                proxy_enforced = True
                if egress_proxy:
                    launch_kwargs["proxy"] = {"server": egress_proxy, "bypass": "<-loopback>"}
                elif os.environ.get("OCULAR_DISABLE_EGRESS_PROXY") == "1":
                    proxy_enforced = False
                    logger.warning("OCULAR_DISABLE_EGRESS_PROXY=1: using in-browser fetch-follow guard (cookies set on "
                                   "redirect hops and the document URL after redirects are NOT preserved).")
                else:
                    proxy_server, proxy_url = await start_egress_proxy(allowed_hosts=active_allowed)
                    launch_kwargs["proxy"] = {"server": proxy_url, "bypass": "<-loopback>"}
                    logger.info(f"Started in-process egress proxy at {proxy_url}")

                if not self.headless:
                    launch_args.append(f"--window-size={self.viewport_width},{self.viewport_height}")
                    browser: Browser = await p.chromium.launch(headless=False, slow_mo=self.slow_mo, **launch_kwargs)
                else:
                    browser: Browser = await p.chromium.launch(headless=True, slow_mo=0, **launch_kwargs)

                context = await browser.new_context(
                    viewport={"width": self.viewport_width, "height": self.viewport_height},
                    color_scheme="dark",
                    service_workers="block",
                    accept_downloads=False,
                    permissions=[],
                )
                await setup_confinement_routes(
                    context,
                    allowed_hosts=active_allowed,
                    blocked_port=self.blocked_port,
                    proxy_enforced=proxy_enforced,
                )
                page: Page = await context.new_page()

                # ---- 3. Navigate (real target only; no mock fallback) ----
                nav_timeout = float(self.timeout_ms)
                logger.info(f"Navigating to {_safe_url(target_nav_url)} (timeout {nav_timeout / 1000:.0f}s)")
                try:
                    response = await page.goto(target_nav_url, wait_until="domcontentloaded", timeout=nav_timeout)
                except Exception as nav_exc:
                    logger.exception(f"Navigation to {_safe_url(target_nav_url)} failed")
                    err_str = str(nav_exc)
                    if "ERR_BLOCKED_BY_CLIENT" in err_str or "ERR_TUNNEL_CONNECTION_FAILED" in err_str or "TARGET_BLOCKED" in err_str:
                        err_code = "TARGET_BLOCKED"
                    elif "Timeout" in err_str or "timed out" in err_str.lower():
                        err_code = "TIMEOUT"
                    else:
                        err_code = "NAV_FAILED"
                    return _fail(err_code, f"Live connection to '{_safe_url(target_nav_url)}' failed: {nav_exc}")

                policy_blocked = bool(response is not None and response.headers.get("x-ocular-policy") == "blocked")
                if response is None or response.status < 200 or response.status >= 400:
                    resp_status = response.status if response else "no response"
                    logger.error(f"Navigation to {_safe_url(target_nav_url)} returned HTTP {resp_status}")
                    return _fail(
                        "TARGET_BLOCKED" if policy_blocked else "NAV_HTTP_ERROR",
                        f"Navigation to '{_safe_url(target_nav_url)}' returned HTTP {resp_status}"
                        + (" (blocked by Ocular egress policy: add the host to OCULAR_ALLOWED_HOSTS if intended)" if policy_blocked else ""),
                    )

                final_url = page.url
                nav_info = {"requested": _safe_url(target_nav_url), "final": _safe_url(final_url), "status": response.status}
                logger.info(f"Navigation OK: requested={nav_info['requested']} final={nav_info['final']} status={response.status}")
                if urlparse(final_url).path.rstrip("/") != urlparse(target_nav_url).path.rstrip("/"):
                    logger.warning(
                        f"Landed on {nav_info['final']} but the workflow was compiled for {nav_info['requested']}. "
                        "The site redirected (login wall / consent / geo / bot check?); steps may not find their targets."
                    )

                # SPA hydration: best-effort settle (never fatal; busy sites never reach network idle)
                try:
                    await page.wait_for_load_state("networkidle", timeout=4000)
                except Exception:
                    pass
                await self._wait_for_first_target(page, self.ACTION_STEPS[0])

                # Dynamically replay action nodes parsed from state_graph.json
                overall_success = True
                unverified_error = None
                for step in self.ACTION_STEPS:
                    action = step.get("action", "click")
                    target = step.get("target_anchor")
                    norm_x = step.get("norm_x")
                    norm_y = step.get("norm_y")
                    param_ref = step.get("parameter_ref")
                    step_timeout = step.get("timeout_ms")
                    best_effort = step.get("best_effort", False)

                    if action in ("fill", "type", "input"):
                        val = parameters.get(param_ref) if param_ref else step.get("default_value", "")
                        if val is None:
                            val = step.get("default_value", "") or ""
                        step_res = await self.fill_target(page, target, val, norm_x=norm_x, norm_y=norm_y, timeout_ms=step_timeout)
                        steps_executed.append(step_res)
                    else:
                        step_res = await self.click_target(page, target, norm_x=norm_x, norm_y=norm_y, timeout_ms=step_timeout)
                        steps_executed.append(step_res)

                    if not step_res.get("verified", False):
                        overall_success = False
                        unverified_error = step_res.get("error") or f"Step '{target}' postcondition verification failed"
                        if not best_effort:
                            break

                if not self.headless:
                    await page.wait_for_timeout(2000)

                await browser.close()
                latency_ms = round((time.perf_counter() - t_start) * 1000.0, 2)

                if not overall_success:
                    num_verified = sum(1 for s in steps_executed if s.get("verified"))
                    status_str = "partial" if num_verified > 0 else "error"
                    return _redact_workflow_results({
                        "navigation": nav_info,
                        "status": status_str,
                        "success": False,
                        "error_code": "STEP_UNVERIFIED",
                        "error": unverified_error or "Workflow step postcondition verification failed",
                        "workflow": self.WORKFLOW_NAME,
                        "parameters": active_inputs,
                        "latency_ms": latency_ms,
                        "steps": steps_executed,
                        "compile_hash": self.COMPILE_HASH,
                    })

                return _redact_workflow_results({
                    "navigation": nav_info,
                    "status": "success",
                    "success": True,
                    "workflow": self.WORKFLOW_NAME,
                    "parameters": active_inputs,
                    "latency_ms": latency_ms,
                    "steps": steps_executed,
                    "compile_hash": self.COMPILE_HASH,
                })
        except Exception as e:
            logger.exception("Workflow execution crashed")
            err_str = str(e)
            err_code = "TIMEOUT" if ("Timeout" in err_str or "timed out" in err_str.lower()) else "INTERNAL_ERROR"
            return _fail(err_code, f"Execution failed: {e}", steps=steps_executed)
        finally:
            if proxy_server is not None:
                try:
                    proxy_server.close()
                except Exception:
                    pass

    async def _wait_for_first_target(self, page: Page, step: Dict[str, Any]) -> None:
        """Wait (bounded) until the first step's element exists; JS-rendered pages are not ready at DOMContentLoaded."""
        anchor_id = step.get("target_anchor") or ""
        anchor = self.ANCHORS.get(anchor_id, {}) or {}
        selector = step.get("selector") or anchor.get("suggested_selector") or ""
        esc_id = str(anchor_id).replace("\\", "\\\\").replace('"', '\\"')
        candidates = [c for c in (selector, f'[id="{esc_id}"]' if anchor_id else "") if c]
        # Canvas targets (charts/maps) carry synthetic selectors like 'canvas.chart_canvas' that no real page has:
        # fall back to "any canvas is present" instead of burning the whole ready timeout.
        if any(c.lower().startswith("canvas") for c in candidates) or "canvas" in anchor_id.lower():
            candidates.append("canvas")
        deadline = time.monotonic() + self.ready_timeout_ms / 1000.0
        while time.monotonic() < deadline:
            for cand in candidates:
                try:
                    if await page.locator(cand).count() > 0:
                        logger.info(f"First target ready: {cand}")
                        return
                except Exception:
                    continue
            await asyncio.sleep(0.25)
        logger.warning(f"First target not found within {self.ready_timeout_ms} ms (candidates={candidates}); "
                       "continuing with role/visual fallbacks.")


