def _debug_enabled() -> bool:
    return os.environ.get("OCULAR_DEBUG", "") in ("1", "true", "TRUE", "yes")


def _format_tb() -> Optional[str]:
    """Scrubbed traceback of the exception being handled (only when OCULAR_DEBUG=1 / --verbose)."""
    if not _debug_enabled():
        return None
    try:
        return scrub_exception(traceback.format_exc(), secrets=[])
    except Exception:
        return traceback.format_exc()


def _safe_url(url: str) -> str:
    """scheme://host/path only: never echo query strings or fragments (tokens live there)."""
    try:
        p = urlparse(url)
        return f"{p.scheme}://{p.hostname}{':' + str(p.port) if p.port else ''}{p.path}"
    except Exception:
        return "<unparseable>"

