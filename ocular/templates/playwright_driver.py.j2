if __name__ == "__main__":
    import argparse
    import json

    TARGET_URL = {{ workflow_class_name }}.TARGET_URL

    parser = argparse.ArgumentParser(description="Ocular Compiled Playwright Driver")
    parser.add_argument(
        "--headed",
        action="store_true",
        help="Launch interactive visible browser window",
    )
    parser.add_argument(
        "--slow-mo",
        type=int,
        default=None,
        help="Slow down Playwright actions by milliseconds for clarity (default: 500ms when headed)",
    )
    parser.add_argument(
        "--base-url",
        "-u",
        "--url",
        type=str,
        default=TARGET_URL,
        help="Target application root URL",
    )
    parser.add_argument(
        "--params",
        type=str,
        default="{}",
        help="JSON string with custom dynamic workflow parameters (e.g. '{\"query\": \"test\"}')",
    )
    parser.add_argument(
        "--live",
        action="store_true",
        help="Interact directly with the live web application at TARGET_URL",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit raw JSON execution telemetry output",
    )
    parser.add_argument(
        "--verbose",
        "-v",
        action="store_true",
        help="Debug logging + full (scrubbed) tracebacks in the result",
    )
    args = parser.parse_args()
    if args.verbose:
        os.environ["OCULAR_DEBUG"] = "1"
    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format="%(asctime)s %(levelname)-7s %(name)s: %(message)s",
        stream=sys.stderr,
    )
    for _noisy in ("asyncio", "playwright", "urllib3"):
        logging.getLogger(_noisy).setLevel(logging.WARNING)

    payload = {}
    if args.params:
        try:
            extra_params = json.loads(args.params)
            if not isinstance(extra_params, dict):
                sys.stderr.write("Error: --params must be a valid JSON object string\n")
                sys.exit(1)
            payload.update(extra_params)
        except Exception as e:
            sys.stderr.write(f"Error: Invalid --params JSON: {e}\n")
            sys.exit(1)

    slow_mo = args.slow_mo if args.slow_mo is not None else (500 if args.headed else 0)
    driver = {{ workflow_class_name }}(
        base_url=args.base_url,
        headless=not args.headed,
        slow_mo=slow_mo,
    )
    result = asyncio.run(driver.run(payload))

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        try:
            from rich import box
            from rich.console import Console
            from rich.table import Table

            console = Console()
            strategies = [s.get("strategy") for s in result.get("steps", []) if s.get("strategy")]
            if "semantic_accessibility" in strategies and "sam_visual_coordinates" in strategies:
                strategy_text = "[yellow]Hybrid (Semantic Primary -> SAM Fallback)[/yellow]"
            elif "semantic_accessibility" in strategies:
                strategy_text = "[bold green]Semantic Accessibility (Roles / Locators)[/bold green]"
            else:
                strategy_text = "[bold cyan]Meta SAM 3.1 Visual Coordinates[/bold cyan]"

            target_anchor = result.get("target_anchor")
            if not target_anchor and result.get("steps"):
                target_anchor = result["steps"][-1].get("anchor") or result["steps"][0].get("anchor")
            target_anchor = target_anchor or "N/A"

            latency_ms = result.get("latency_ms", 0.0)
            compile_hash = result.get("compile_hash", "N/A")

            table = Table(
                box=box.ROUNDED,
                title="[bold cyan]Ocular Driver Execution Telemetry[/bold cyan]",
                header_style="bold magenta",
                show_header=True,
            )
            table.add_column("Telemetry Metric", style="bold white", width=26)
            table.add_column("Value / Status", style="cyan")

            table.add_row("Workflow Class", f"[bold green]{driver.__class__.__name__}[/bold green]")
            table.add_row("Execution Strategy", strategy_text)
            table.add_row("Browser Mode", "Visible (Headed)" if args.headed else "Headless (AOT Fast)")
            table.add_row("Target Anchor", f"[yellow]{target_anchor}[/yellow]")
            table.add_row("Steps Executed", f"[bold cyan]{len(result.get('steps', []))}[/bold cyan]")
            table.add_row("End-to-End Latency", f"[bold green]{latency_ms:.2f} ms[/bold green]")
            table.add_row("Runtime Inference Cost", "[bold green]$0.00 (Zero Runtime Vision)[/bold green]")
            table.add_row("Compile Hash", f"[dim]{compile_hash}[/dim]")
            nav = result.get("navigation") or {}
            if nav:
                table.add_row("Landed URL", f"[dim]{nav.get('final', 'N/A')}[/dim]")
            st = result.get("status")
            status_cell = (
                "[bold green]✓ PASSED[/bold green]" if st == "success"
                else "[bold yellow]◐ PARTIAL[/bold yellow]" if st == "partial"
                else "[bold red]✗ FAILED[/bold red]"
            )
            table.add_row("Execution Status", status_cell)
            if st != "success":
                table.add_row("Error Code", f"[red]{result.get('error_code', 'N/A')}[/red]")
                table.add_row("Error", f"[red]{str(result.get('error', ''))[:300]}[/red]")

            console.print(table)
            if result.get("traceback"):
                console.print("[dim]" + result["traceback"] + "[/dim]")
        except Exception:
            print(json.dumps(result, indent=2))
    sys.exit(0 if result.get("status") == "success" else 1)
