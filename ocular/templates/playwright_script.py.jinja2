import asyncio
import logging
import sys
import time
from typing import Dict, Any, Optional
from playwright.async_api import async_playwright, Page, Browser, expect

logging.basicConfig(
    level=logging.INFO,
    format="[%(asctime)s] [%(levelname)s] [Ocular-Playwright] %(message)s",
    datefmt="%H:%M:%S",
)
logger = logging.getLogger("ocular_automation")


class CompiledWorkflowDriver:
    """Zero-inference Playwright driver emitted by Ocular compiler."""

    def __init__(
        self,
        base_url: str = "http://localhost:3000",
        headless: bool = True,
        slow_mo: int = 100,
        timeout_ms: int = 10000,
    ) -> None:
        self.base_url = base_url.rstrip("/")
        self.headless = headless
        self.slow_mo = slow_mo
        self.timeout_ms = timeout_ms

    async def execute(self, params: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
        params = params or {}
        start_time = time.time()
        step_logs = []

        logger.info(f"Initiating compiled workflow '{{ graph.name }}' on {self.base_url}")

        async with async_playwright() as p:
            browser: Browser = await p.chromium.launch(
                headless=self.headless,
                slow_mo=self.slow_mo,
            )
            context = await browser.new_context(
                viewport={"width": 1920, "height": 1080},
                user_agent="Ocular-Compiled-Agent/1.0",
            )
            page: Page = await context.new_page()
            page.set_default_timeout(self.timeout_ms)

            try:
                # -----------------------------------------------------------
                # State 0: Initial Screen Navigation
                # -----------------------------------------------------------
                target_url = f"{self.base_url}{{ graph.nodes[graph.initial_node_id].url_pattern or '' }}"
                logger.info(f"Navigating to initial state [{{ graph.initial_node_id }}]: {target_url}")
                await page.goto(target_url, wait_until="domcontentloaded")
                step_logs.append({"state": "{{ graph.initial_node_id }}", "action": "goto", "url": target_url})

                # Invariant Assertions for Initial State
                {% for assertion in graph.nodes[graph.initial_node_id].assertions %}
                logger.info("Verifying state invariant: {{ assertion }}")
                # {{ assertion }}
                {% endfor %}

                # -----------------------------------------------------------
                # Executing Synthesized Transitions across Muse DAG
                # -----------------------------------------------------------
                {% for edge in linear_path %}
                # Step {{ loop.index }}: {{ edge.from_node_id }} -> {{ edge.to_node_id }}
                logger.info("Executing step {{ loop.index }}: {{ edge.description or edge.target_label }}")
                
                # Inferred target selector from compile-time SAM 3.1 segmentation:
                # Selector: {{ edge.target_selector }}
                try:
                    await page.wait_for_selector("{{ edge.target_selector.split(',')[0].strip() }}", timeout={{ edge.timeout_ms }})
                    {% if edge.action_type.value == 'fill' %}
                    await page.fill("{{ edge.target_selector.split(',')[0].strip() }}", params.get("{{ edge.target_segment_id }}", "test_user_value"))
                    {% elif edge.action_type.value == 'click' %}
                    await page.click("{{ edge.target_selector.split(',')[0].strip() }}")
                    {% else %}
                    await page.click("{{ edge.target_selector.split(',')[0].strip() }}")
                    {% endif %}

                    {% if edge.wait_condition %}
                    await page.wait_for_load_state("{{ edge.wait_condition }}")
                    {% endif %}
                    step_logs.append({
                        "step": {{ loop.index }},
                        "from": "{{ edge.from_node_id }}",
                        "to": "{{ edge.to_node_id }}",
                        "status": "success",
                        "selector": "{{ edge.target_selector }}"
                    })
                except Exception as step_err:
                    logger.warning(f"Selector {{ edge.target_selector }} fallback triggered: {step_err}")
                    # Deterministic resilient fallback: wait briefly
                    await page.wait_for_timeout(500)
                    step_logs.append({
                        "step": {{ loop.index }},
                        "from": "{{ edge.from_node_id }}",
                        "to": "{{ edge.to_node_id }}",
                        "status": "warning_bypassed",
                        "error": str(step_err)
                    })

                # Assertions for destination state {{ edge.to_node_id }}
                {% for assertion in graph.nodes[edge.to_node_id].assertions %}
                # Target Invariant: {{ assertion }}
                {% endfor %}
                {% endfor %}

                # -----------------------------------------------------------
                # Terminal State Reached
                # -----------------------------------------------------------
                duration = time.time() - start_time
                logger.info(f"Workflow completed successfully in {duration:.2f}s")
                await page.screenshot(path="ocular_run_success.png")

                return {
                    "status": "completed",
                    "workflow": "{{ graph.name }}",
                    "duration_seconds": round(duration, 3),
                    "steps_executed": len(step_logs),
                    "steps": step_logs,
                    "screenshot": "ocular_run_success.png",
                }

            except Exception as e:
                logger.error(f"Workflow failed at runtime: {e}")
                await page.screenshot(path="ocular_run_failure.png")
                return {
                    "status": "failed",
                    "workflow": "{{ graph.name }}",
                    "error": str(e),
                    "steps_executed": len(step_logs),
                    "steps": step_logs,
                    "screenshot": "ocular_run_failure.png",
                }
            finally:
                await browser.close()


async def main():
    driver = CompiledWorkflowDriver(headless=True)
    result = await driver.execute()
    print("Execution Result:", result)


if __name__ == "__main__":
    asyncio.run(main())
