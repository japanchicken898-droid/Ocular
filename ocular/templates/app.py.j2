@app.get("/api/v1/schema", tags=["System"], dependencies=[Depends(verify_api_key)])
async def get_parameters_schema() -> Dict[str, Any]:
    """Returns the parameterized dynamic inputs schema and visual anchors registry."""
    schema_dict = ExecutionPayload.model_json_schema()
    props = schema_dict.get("properties", {})
    for p_name, p_def in props.items():
        if _is_sensitive_identifier(p_name):
            p_def.pop("default", None)
            p_def["description"] = f"Credential parameter {p_name}"

    clean_inputs = []
    raw_inputs = WORKFLOW_DATA.get("input_fields", {})
    if isinstance(raw_inputs, dict):
        raw_inputs = list(raw_inputs.values())
    for inp in raw_inputs:
        inp_copy = dict(inp)
        k = inp_copy.get("key", "")
        sel = inp_copy.get("selector", "")
        lbl = inp_copy.get("label", "")
        if _is_sensitive_identifier(k) or _is_sensitive_identifier(sel) or _is_sensitive_identifier(lbl):
            inp_copy["default_value"] = ""
        clean_inputs.append(inp_copy)

    return {
        "workflow": WORKFLOW_NAME,
        "compile_hash": COMPILE_HASH,
        "parameters_schema": schema_dict,
        "input_parameters": clean_inputs,
        "anchors_count": len(WORKFLOW_DATA.get("anchors", {})),
        "zero_runtime_vision": True,
    }


@app.post("/api/v1/execute", response_model=ExecuteWorkflowResponse, tags=["Execution"], dependencies=[Depends(verify_api_key)])
async def execute_workflow(
    payload: Union[ExecuteWorkflowRequest, ExecutionPayload],
    response: Response
) -> ExecuteWorkflowResponse:
    """Executes the compiled workflow deterministically with dynamic parameter binding."""
    t0 = time.perf_counter()
    execution_id = f"exec_{uuid.uuid4().hex[:12]}"

    req_base_url = None
    req_width = 1280
    req_height = 720
    req_headless = True
    req_live = True
    req_timeout = 10000

    if isinstance(payload, ExecuteWorkflowRequest):
        req_width = payload.viewport_width
        req_height = payload.viewport_height
        req_timeout = payload.timeout_ms
        if payload.base_url:
            req_base_url = await validate_safe_url(payload.base_url)
        req_headless = payload.headless
        req_live = payload.live
        raw_params = dict(payload.parameters) if payload.parameters is not None else {}
        extra_fields = payload.model_extra or {}
        combined_params = {**extra_fields, **raw_params}
        try:
            typed_payload = ExecutionPayload(**combined_params)
        except ValidationError as val_exc:
            raise HTTPException(
                status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
                detail=_clean_validation_errors(val_exc.errors()),
            )
    elif isinstance(payload, ExecutionPayload):
        typed_payload = payload
        raw_dict = payload.model_dump()
        req_width = raw_dict.get("viewport_width", 1280)
        req_height = raw_dict.get("viewport_height", 720)
        req_headless = raw_dict.get("headless", True)
        req_timeout = raw_dict.get("timeout_ms", 10000)
    else:
        try:
            typed_payload = ExecutionPayload()
        except ValidationError as val_exc:
            raise HTTPException(
                status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
                detail=_clean_validation_errors(val_exc.errors()),
            )

    queue_timeout_sec = float(os.environ.get("OCULAR_QUEUE_TIMEOUT_SEC", "5.0"))
    try:
        await asyncio.wait_for(_execution_semaphore.acquire(), timeout=queue_timeout_sec)
    except asyncio.TimeoutError:
        raise HTTPException(
            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
            detail="Server queue saturated. Try again later.",
        )

    try:
        app_port = int(os.environ.get("PORT", "8000"))
        req_driver = {{ workflow_class_name }}(
            base_url=req_base_url,
            viewport_width=req_width,
            viewport_height=req_height,
            headless=req_headless,
            live=req_live,
            blocked_port=app_port,
        )
        run_deadline = min(float(req_timeout) / 1000.0, 120.0)
        try:
            result = await asyncio.wait_for(
                req_driver.execute_workflow(params=typed_payload.model_dump(by_alias=True)),
                timeout=run_deadline,
            )
        except asyncio.TimeoutError:
            result = {
                "status": "error",
                "success": False,
                "error_code": "TIMEOUT",
                "error": "Execution deadline exceeded",
                "steps": [],
            }

        latency_ms = round((time.perf_counter() - t0) * 1000.0, 3)
        response.headers["X-Ocular-Compile-Hash"] = COMPILE_HASH
        response.headers["X-Execution-Latency-MS"] = str(latency_ms)

        steps = result.get("steps", [])
        success_status = result.get("success", result.get("status") == "success")
        raw_err = result.get("error")
        sanitized_err = None
        err_code = None
        if not success_status:
            err_code = result.get("error_code") or classify_error_code(raw_err or "")
            result["error_code"] = err_code
            sanitized_err = [_sanitize_error_message(raw_err or "Execution failed")]
            response.status_code = status.HTTP_500_INTERNAL_SERVER_ERROR

        return ExecuteWorkflowResponse(
            success=success_status,
            execution_id=execution_id,
            workflow_name=WORKFLOW_NAME,
            compile_hash=COMPILE_HASH,
            latency_ms=latency_ms,
            steps_executed=len(steps),
            results=result,
            errors=sanitized_err,
            error_code=err_code,
        )
    except Exception as exc:
        latency_ms = round((time.perf_counter() - t0) * 1000.0, 3)
        response.headers["X-Ocular-Compile-Hash"] = COMPILE_HASH
        response.headers["X-Execution-Latency-MS"] = str(latency_ms)
        response.status_code = status.HTTP_500_INTERNAL_SERVER_ERROR
        err_code = classify_error_code(str(exc))

        return ExecuteWorkflowResponse(
            success=False,
            execution_id=execution_id,
            workflow_name=WORKFLOW_NAME,
            compile_hash=COMPILE_HASH,
            latency_ms=latency_ms,
            steps_executed=0,
            results={"error_code": err_code},
            errors=[_sanitize_error_message(str(exc))],
            error_code=err_code,
        )
    finally:
        _execution_semaphore.release()


