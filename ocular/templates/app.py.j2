# Request Body Limit: Max 2 MB to block memory bloat and JSON DoS attacks
MAX_REQUEST_BODY_BYTES = int(os.environ.get("OCULAR_MAX_BODY_SIZE_BYTES", str(2 * 1024 * 1024)))


@app.middleware("http")
async def limit_request_body_size(request: Request, call_next):
    """Enforces request payload size limits against DoS payload attacks."""
    if request.method == "POST" and request.url.path.endswith("/api/v1/execute"):
        content_length = request.headers.get("content-length")
        if content_length:
            try:
                if int(content_length) > MAX_REQUEST_BODY_BYTES:
                    return Response(
                        content=json.dumps({"detail": f"Request body exceeds maximum permitted size of {MAX_REQUEST_BODY_BYTES} bytes."}),
                        status_code=status.HTTP_413_REQUEST_ENTITY_TOO_LARGE,
                        media_type="application/json",
                    )
            except ValueError:
                pass

        body = await request.body()
        if len(body) > MAX_REQUEST_BODY_BYTES:
            return Response(
                content=json.dumps({"detail": f"Request body exceeds maximum permitted size of {MAX_REQUEST_BODY_BYTES} bytes."}),
                status_code=status.HTTP_413_REQUEST_ENTITY_TOO_LARGE,
                media_type="application/json",
            )

    return await call_next(request)


def _is_sensitive_identifier(val: Any) -> bool:
    if not val:
        return False
    text = str(val).lower()
    if 'type="password"' in text or "type='password'" in text:
        return True
    pattern = r"(?:^|[^a-z0-9])(password|passwd|pwd|pass|passcode|passphrase|secret|token|jwt|bearer|session|cookie|otp|2fa|mfa|pin|ssn|cvv|cvc|csc|cardnumber|iban|routing|api[_\s-]?key|private[_\s-]?key|secret[_\s-]?key|access[_\s-]?key|auth[_\s-]?key|one[_\s-]?time(?:[_\s-]?code)?|cc[_\s-]?number|card[_\s-]?number|credit[_\s-]?card)(?:$|[^a-z0-9])"
    return bool(re.search(pattern, text, re.IGNORECASE))


def _build_execution_payload_model() -> Type[BaseModel]:
    schema = getattr({{ workflow_class_name }}, "PARAMETERS_SCHEMA", {}) or {}
    props = schema.get("properties", {})
    field_defs = {
        "viewport_width": (int, Field(default=1280, description="Browser viewport width in pixels")),
        "viewport_height": (int, Field(default=720, description="Browser viewport height in pixels")),
        "headless": (bool, Field(default=True, description="Whether to run browser in headless mode")),
        "timeout_ms": (int, Field(default=10000, description="Execution timeout in milliseconds")),
    }
    type_map = {"integer": int, "number": float, "boolean": bool, "string": str}
    for p_name, p_meta in props.items():
        if p_name not in field_defs:
            p_type_str = p_meta.get("type", "string")
            py_t = type_map.get(p_type_str, str)
            def_val = None if _is_sensitive_identifier(p_name) else p_meta.get("default", None)
            field_defs[p_name] = (Optional[py_t], Field(default=def_val, description=p_meta.get("description", "")))
    return create_model("ExecutionPayload", **field_defs, __config__=ConfigDict(extra="allow"))


