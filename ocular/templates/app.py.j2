async def validate_safe_url(url: str, allow_local: Optional[bool] = None) -> str:
    """Validates that base_url does not resolve to private, loopback, or metadata subnets (SSRF protection)."""
    if not url or not isinstance(url, str):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="A valid URL string is required."
        )

    try:
        canonical_url = canonicalize_url(url)
    except Exception as exc:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Invalid or prohibited URL format: {exc}"
        )

    parsed = urlparse(canonical_url)
    hostname = parsed.hostname
    port = parsed.port

    allowed = get_allowed_hosts()
    if is_loopback_or_private_host(hostname) and not is_host_allowed(hostname, port, allowed):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Target URL points to blocked loopback address: '{hostname}'."
        )

    try:
        is_blocked = await resolve_and_check_host(hostname, port=port, allowed_hosts=allowed)
    except Exception as exc:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Unable to safely resolve target host '{hostname}': {exc}"
        )

    if is_blocked:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Target URL '{hostname}' resolves to restricted private/loopback subnet or prohibited host."
        )

    return canonical_url.rstrip("/")


