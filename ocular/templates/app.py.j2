_is_sensitive_identifier = is_sensitive_field


def classify_error_code(err: str, status_code: Optional[int] = None) -> str:
    """Classifies raw errors into stable sanitized error codes."""
    err_lower = (err or "").lower()
    if "target_blocked" in err_lower or "blocked by client" in err_lower or "blocked_by_client" in err_lower or "prohibited" in err_lower or "ssrf" in err_lower:
        return "TARGET_BLOCKED"
    if "timeout" in err_lower or "timed out" in err_lower or "deadline exceeded" in err_lower:
        return "TIMEOUT"
    if "postcondition" in err_lower or "unverified" in err_lower or "step_unverified" in err_lower:
        return "STEP_UNVERIFIED"
    if "http 4" in err_lower or "http 5" in err_lower or (status_code and status_code >= 400):
        return "NAV_HTTP_ERROR"
    if "connection refused" in err_lower or "err_connection" in err_lower or "failed to connect" in err_lower or "name not resolved" in err_lower or "nav_failed" in err_lower:
        return "NAV_FAILED"
    return "INTERNAL_ERROR"


def _sanitize_error_message(err: str) -> str:
    """Removes file paths, internal IPs, and raw stack traces from user-facing error messages."""
    if not err:
        return "Workflow execution failed."
    err = scrub_exception(err)
    err = re.sub(r'Traceback \(most recent call last\):.*?\n(?=[a-zA-Z0-9_]+:)', '', err, flags=re.DOTALL)
    err = re.sub(r'File ".*?", line \d+, in .*', '', err)
    err = re.sub(r'(?:/|[a-zA-Z]:\\)[\w\-./\\]+', '[PATH]', err)
    err = re.sub(r'\b(?:\d{1,3}\.){3}\d{1,3}\b', '[HOST]', err)
    if "Connection refused" in err or "ERR_CONNECTION_REFUSED" in err or "failed to connect" in err.lower():
        return "Connection to target service failed or unreachable."
    if "Timeout" in err or "timed out" in err.lower():
        return "Operation timed out."
    if "HTTP 4" in err or "HTTP 5" in err:
        return "Target service returned an error status."
    if "postcondition verification failed" in err:
        return "Step postcondition verification failed."
    return "Workflow execution encountered an error."


RESERVED_FIELD_NAMES = {
    "dict", "json", "copy", "parse_obj", "schema", "validate",
    "model_config", "model_dump", "model_fields", "model_extra",
}


def _build_execution_payload_model() -> Type[BaseModel]:
    schema = WORKFLOW_DATA.get("parameters_schema", {}) or {}
    props = schema.get("properties", {})
    required_fields = set(schema.get("required", []))
    field_defs = {
        "viewport_width": (int, Field(default=1280, ge=200, le=3840, description="Browser viewport width in pixels")),
        "viewport_height": (int, Field(default=720, ge=200, le=2160, description="Browser viewport height in pixels")),
        "headless": (bool, Field(default=True, description="Whether to run browser in headless mode")),
        "timeout_ms": (int, Field(default=10000, ge=1000, le=120000, description="Execution timeout in milliseconds")),
    }
    type_map = {"integer": int, "number": float, "boolean": bool, "string": str}
    for p_name, p_meta in props.items():
        p_type_str = p_meta.get("type", "string")
        py_t = type_map.get(p_type_str, str)

        field_name = f"param_{p_name}" if (p_name in RESERVED_FIELD_NAMES or p_name.startswith("_")) else p_name
        alias_name = p_name if field_name != p_name else None

        if field_name not in field_defs:
            field_kwargs = {
                "description": p_meta.get("description", ""),
            }
            if alias_name:
                field_kwargs["alias"] = alias_name

            if p_name in required_fields:
                field_defs[field_name] = (py_t, Field(..., **field_kwargs))
            else:
                def_val = None if _is_sensitive_identifier(p_name) else p_meta.get("default", None)
                field_kwargs["default"] = def_val
                field_defs[field_name] = (Optional[py_t], Field(**field_kwargs))

    return create_model("ExecutionPayload", **field_defs, __config__=ConfigDict(extra="forbid", populate_by_name=True))


ExecutionPayload = _build_execution_payload_model()


