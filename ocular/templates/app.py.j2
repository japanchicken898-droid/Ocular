async def get_parameters_schema() -> Dict[str, Any]:
    """Returns the parameterized dynamic inputs schema and visual anchors registry."""
    schema_dict = ExecutionPayload.model_json_schema()
    props = schema_dict.get("properties", {})
    for p_name, p_def in props.items():
        if _is_sensitive_identifier(p_name):
            p_def.pop("default", None)
            p_def["description"] = f"Credential parameter {p_name}"

    clean_inputs = []
    raw_inputs = getattr({{ workflow_class_name }}, "INPUT_FIELDS", [])
    if isinstance(raw_inputs, dict):
        raw_inputs = list(raw_inputs.values())
    for inp in raw_inputs:
        inp_copy = dict(inp)
        k = inp_copy.get("key", "")
        sel = inp_copy.get("selector", "")
        lbl = inp_copy.get("label", "")
        if _is_sensitive_identifier(k) or _is_sensitive_identifier(sel) or _is_sensitive_identifier(lbl):
            inp_copy["default_value"] = ""
        clean_inputs.append(inp_copy)

    return {
        "workflow": WORKFLOW_NAME,
        "compile_hash": COMPILE_HASH,
        "parameters_schema": schema_dict,
        "input_parameters": clean_inputs,
        "anchors_count": len(getattr({{ workflow_class_name }}, "ANCHORS", {})),
