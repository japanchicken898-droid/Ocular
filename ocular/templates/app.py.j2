# Authentication dependency
def verify_api_key(request: Request) -> None:
    expected_key = os.environ.get("OCULAR_API_KEY")
    insecure_no_auth = os.environ.get("OCULAR_INSECURE_NO_AUTH") == "1"
    if not expected_key:
        if insecure_no_auth:
            return
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Authentication required: OCULAR_API_KEY is not configured.",
        )
    provided_key = request.headers.get("X-API-Key", "")
    if not provided_key:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid or missing X-API-Key header.",
        )
    try:
        provided_key.encode("ascii")
    except UnicodeEncodeError:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid or missing X-API-Key header.",
        )
    provided_bytes = provided_key.encode("utf-8", "surrogateescape")
    expected_bytes = expected_key.encode("utf-8", "surrogateescape")
    if not secrets.compare_digest(provided_bytes, expected_bytes):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid or missing X-API-Key header.",
        )


